generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  // Nullable: OAuth-only users (e.g. signed up with Google) never set a
  // password. Email/password signup still requires it; the auth route
  // enforces presence at runtime.
  passwordHash      String?
  emailVerifiedAt   DateTime?
  tokenVersion      Int       @default(0)
  withdrawalPinHash String? // bcrypt hash of withdrawal PIN; null = no PIN set
  // Optional display name — populated from OAuth profile on first sign-in.
  // Email/password users can fill it later via /api/auth/me PATCH (future).
  name              String?
  // Optional avatar URL — populated from OAuth profile on first sign-in.
  avatarUrl         String?
  // App-wide role. USER is the default; ADMIN unlocks /admin back-office;
  // SUPERADMIN can promote/demote other admins. Bootstrap an initial
  // SUPERADMIN via `pnpm db:make-superadmin <email>` (see scripts).
  role              String    @default("USER") // USER | ADMIN | SUPERADMIN
  // Account status. ACTIVE = login + refresh allowed; SUSPENDED = both
  // refused with 403 ACCOUNT_SUSPENDED. Mutated via /api/admin/users/[id]/status
  // (ADMIN can suspend; only SUPERADMIN can restore).
  status            String    @default("ACTIVE") // ACTIVE | SUSPENDED
  // Liste d'attente Premium (teaser) : horodatage quand l'utilisateur clique
  // « Être prévenu ». null = pas (encore) intéressé. Sert au comptage de la demande.
  premiumInterestAt DateTime?
  // Onboarding : horodatage de la fermeture de la modale de bienvenue.
  // null = jamais vue → on l'affiche une seule fois, à vie, après création du
  // compte. Renseigné via POST /api/auth/onboarded. Les comptes existants sont
  // rétro-remplis (migration) pour ne PAS revoir l'accueil.
  onboardedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  verificationCodes VerificationCode[]
  uploads           FileUpload[]
  notifications     Notification[]
  notifPrefs        NotificationPreferences?
  orders            Order[]
  withdrawals       Withdrawal[]
  oauthAccounts     OAuthAccount[]
  adminActions      AdminAction[]

  // Multi-tenancy is opt-in per project: by default no resource is org-scoped.
  // Apps that need it (marketplace, B2B SaaS, classifieds) wire owner relations
  // on their domain models.
  ownedOrganizations Organization[]      @relation("OrgOwner")
  memberships        OrganizationMember[] @relation("OrgMembership")

  @@index([email])
  @@index([role])
  @@index([status])
}

// ───────────────────────────────────────────────────────────────────────
// Admin audit log — every back-office mutation is recorded here so we can
// answer "who did what when" during incidents / compliance reviews.
//
// `action` is a free-form dotted string the UI groups by (e.g.
// "withdrawal.cancel", "user.role_change", "order.refund").
// `targetType` + `targetId` reference the affected row when applicable.
// `metadata` carries the diff or extra context as JSON.
//
// Retention: not pruned automatically (compliance). If your jurisdiction
// requires deletion after N years, add a cron in backend/src/index.ts
// modeled on the WebhookLog purge.
// ───────────────────────────────────────────────────────────────────────
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// ───────────────────────────────────────────────────────────────────────
// Multi-tenancy primitives — opt-in.
//
// Default project surface stays user-owned (`Order.userId`, `Withdrawal.userId`).
// Apps that need orgs add `organizationId String?` to their domain models
// case by case and use `requireOrgRole()` middleware to gate access.
//
// Slug must be unique app-wide (not just within an owner) so it can be
// used as a stable URL segment.
// ───────────────────────────────────────────────────────────────────────
model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  ownerId   String
  owner     User     @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members   OrganizationMember[]
  settings  BoutiqueSettings?
  products  Product[]
  customers Customer[]
  sales     Sale[]
  expenses  Expense[]
  documents Document[]
  subPayments SubscriptionPayment[]
  // ── Abonnement (Phase 8 — SaaS billing, gestion manuelle v1) ──────────────
  // Le STATUT (essai / actif / expiré) n'est jamais stocké : il est DÉRIVÉ de
  // ces trois champs par lib/subscription/status.ts, ce qui évite toute dérive.
  plan             String? // "PREMIUM" — null tant qu'aucun plan choisi
  trialEndsAt      DateTime? // fin de l'essai gratuit (création + TRIAL_DAYS jours)
  currentPeriodEnd DateTime? // fin de l'abonnement payé (null si jamais payé)
  // Compte INTERNE / exonéré (boutiques test, associés, comptes offerts) : accès
  // gratuit permanent (le garde d'abonnement ne bloque jamais) ET exclu de TOUTES
  // les statistiques plateforme (MRR, encaissé, boutiques, ventes…) — ce n'est pas
  // un vrai client. Basculé par un SUPERADMIN depuis la fiche boutique admin.
  internal         Boolean  @default(false)
  // Note interne libre du SUPERADMIN sur ce client (mini-CRM) : contexte, suivi
  // commercial, historique d'échanges. Jamais visible par le patron/vendeurs.
  adminNote        String? // texte libre, null = aucune note
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// Produit du catalogue d'une boutique (Phase 2). Montants entiers en FCFA.
// La quantité (`qty`) ne doit JAMAIS être mutée sans un StockMovement
// correspondant (ledger d'inventaire) — voir /api/products routes.
model Product {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ref            String // référence/SKU, unique par boutique
  name           String
  category       String
  buyPrice       Int             @default(0) // prix d'achat (FCFA entier)
  sellPrice      Int             @default(0) // prix de vente au détail (FCFA entier)
  prixGros       Int             @default(0) // prix de vente en gros (FCFA entier ; 0 = non défini)
  unite          String          @default("piece") // unité de vente (pièce, carton, kg, sac, litre, sachet…), libre
  qty            Int             @default(0) // stock courant (dérivé des mouvements)
  threshold      Int             @default(0) // seuil d'alerte stock faible
  imageUrl       String? // URL Cloudinary publique de la photo du produit
  barcode        String? // code-barres (EAN/UPC…) saisi ou scanné ; null = aucun. Unique par boutique
  expiryDate     DateTime? // date de péremption (optionnelle ; null = produit non périssable)
  movements      StockMovement[]
  saleItems      SaleItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, ref])
  // Un même code-barres ne peut pas désigner deux produits d'une même boutique.
  // (NULL autorisé plusieurs fois : Postgres traite chaque NULL comme distinct.)
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([organizationId, category])
}

// Mouvement de stock (ledger). type: IN (entrée) | OUT (sortie) | ADJUST
// (correction). `delta` est signé. `organizationId` est un scalaire de scoping
// (pas de relation inverse pour ne pas alourdir Organization).
model StockMovement {
  id             String   @id @default(cuid())
  organizationId String
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type           String // IN | OUT | ADJUST
  delta          Int // variation signée de quantité
  reason         String?
  createdById    String? // utilisateur à l'origine du mouvement
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([productId])
}

// Client d'une boutique (Phase 3). Minimal : nom + téléphone. Sert au POS
// (vente à crédit) et de base aux créances (Phase 4).
model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  sales          Sale[]
  receivables    Receivable[]
  repayments     Repayment[]
  documents      Document[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

// Vente (Phase 3). `number` séquentiel par boutique (ex V-0001). `method`:
// CASH | MOBILE | CREDIT | MIXED. `total` = Σ(items) en FCFA entier. Paiement
// mixte : cashAmount + mobileAmount + creditAmount = total ; la part crédit
// (creditAmount) engendre la créance. La création d'une vente décrémente le
// stock via des StockMovement OUT dans la même transaction.
model Sale {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  method         String // CASH | MOBILE | CREDIT | MIXED
  total          Int // total NET encaissé (= brut des lignes − remise)
  discount       Int          @default(0) // remise globale accordée (FCFA)
  cashAmount     Int          @default(0) // part réglée en espèces
  mobileAmount   Int          @default(0) // part réglée en mobile money
  creditAmount   Int          @default(0) // part à crédit (= montant de la créance)
  publicToken    String?      @unique // jeton aléatoire du lien public de reçu (partage client, sans login)
  status         String       @default("ACTIVE") // ACTIVE | CANCELLED
  cancelledAt    DateTime? // horodatage de l'annulation (null tant qu'active)
  cancelledById  String? // utilisateur (Patron/Manager) ayant annulé la vente
  cancelReason   String? // motif d'annulation (obligatoire à l'annulation)
  createdById    String?
  items          SaleItem[]
  receivable     Receivable?
  document       Document?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}

// Ligne de vente. `name` et `unitPrice` sont un instantané au moment de la
// vente (l'historique ne change pas si le produit est édité/supprimé).
model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  qty       Int
  unitPrice Int
  buyPrice  Int      @default(0) // instantané du prix d'achat (marge des rapports)

  @@index([saleId])
}

// Créance (Phase 4) — dette née d'une vente à crédit. `amount` = montant initial
// dû, `amountPaid` = cumul remboursé. `status` stocké pour le filtrage :
// OPEN (rien payé) | PARTIAL (partiellement) | PAID (soldé). 1:1 avec la Sale à
// crédit qui l'a engendrée. Montants entiers FCFA.
model Receivable {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  saleId         String?  @unique
  sale           Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  amount         Int
  amountPaid     Int      @default(0)
  status         String   @default("OPEN") // OPEN | PARTIAL | PAID | CANCELLED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([customerId])
  @@index([organizationId, status])
}

// Dette fournisseur — argent que LA BOUTIQUE doit à un fournisseur/grossiste
// pour du stock acheté « en prêt » (à crédit). Miroir « achat » de Receivable
// (dette client). Créée à l'ajout ou au réapprovisionnement d'un produit quand
// le commerçant n'a pas tout payé. `amount` = montant total dû initialement,
// `amountPaid` = cumul remboursé au fournisseur. `label` fige le nom du produit
// (l'historique ne change pas si le produit est édité/supprimé). `productId` est
// un scalaire de rattachement (pas de relation inverse, comme StockMovement).
// status: OPEN (rien payé) | PARTIAL | PAID (soldé). Montants entiers FCFA.
model SupplierDebt {
  id             String   @id @default(cuid())
  organizationId String
  productId      String?
  label          String
  supplierName   String?
  amount         Int
  amountPaid     Int      @default(0)
  status         String   @default("OPEN") // OPEN | PARTIAL | PAID
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
}

// Remboursement (Phase 4) — paiement reçu d'un client, alloué à ses créances
// ouvertes (les plus anciennes d'abord) dans une transaction. `method` :
// CASH | MOBILE. `amount` = montant effectivement appliqué (≤ dû total).
model Repayment {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount         Int
  method         String // CASH | MOBILE
  note           String?
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([customerId])
}

// Dépense de la boutique (Phase 5). `number` séquentiel par boutique (D-0001).
// `category` = chaîne libre (liste suggérée côté UI). `amount` entier FCFA.
// `occurredAt` = date de la dépense (saisissable, défaut = maintenant).
model Expense {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         String
  label          String
  category       String
  amount         Int
  note           String?
  createdById    String?
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([organizationId, category])
  @@index([organizationId, occurredAt])
}

// Document commercial (Phase 6) — FACTURE ou PROFORMA. `lines` est un INSTANTANÉ
// JSON figé à l'émission ([{ article, qty, unitPrice }]) : le document ne change
// jamais même si le produit est édité/supprimé ou change de prix. `number`
// séquentiel par (boutique, type) : F-0001 pour les factures, PRO-0001 pour les
// proformas. `total` = Σ(qty × unitPrice) figé. `status`: PAID | PENDING | CREDIT.
model Document {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String // FACTURE | PROFORMA | RECU
  number         String
  saleId         String?      @unique // facture issue d'une vente (Phase 3)
  sale           Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  repaymentId    String?      @unique // reçu ↔ remboursement (Phase 7) — dédup si rejoué
  clientName     String // instantané du destinataire
  clientPhone    String?
  status         String // PAID | PENDING | CREDIT
  total          Int // instantané Σ(lignes) ; pour un RECU = montant remboursé
  balanceAfter   Int? // RECU : solde restant du client après ce remboursement
  note           String?
  lines          Json // instantané [{ article, qty, unitPrice }]
  validityDays   Int? // proforma : durée de validité (jours)
  issuedAt       DateTime     @default(now())
  createdById    String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, number])
  @@index([organizationId, type])
  @@index([organizationId, issuedAt])
}

// Profil + préférences d'une boutique (1:1 avec Organization). Créé dans la
// même transaction que l'org lors de l'onboarding (voir ensure-boutique.ts).
// currency par défaut XAF (marché CEMAC v1). Montants applicatifs : entiers,
// dans la plus petite unité (FCFA = pas de décimales).
model BoutiqueSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currency       String       @default("XAF") // XAF | XOF | …
  // Pays de la boutique (ISO 3166-1 alpha-2, ex. "TD"). Fixe l'indicatif
  // téléphonique par défaut → les clients saisissent leur numéro LOCAL et
  // l'envoi WhatsApp recompose le numéro international. Défaut Tchad.
  country        String       @default("TD")
  phone          String?
  city           String?
  address        String?
  invoiceNote    String?
  logoUrl        String? // URL Cloudinary publique du logo de la boutique
  // Type de commerce, renseigné à l'onboarding (clé : alimentation, vetements,
  // electronique, pharmacie, cosmetiques, quincaillerie, restauration, autre).
  businessType   String?
  // Seuils de notifications, réglables par le patron dans Paramètres.
  overdueDays         Int @default(30) // créance « en retard » après N jours
  bigExpenseThreshold Int @default(50000) // « grosse » dépense ≥ ce montant (FCFA)
  expiryAlertDays     Int @default(30) // alerte péremption : N jours avant la date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Journal des paiements d'abonnement (Phase 8). Encaissement MANUEL v1 :
// le patron (OWNER) émet une demande PENDING (espèces / mobile money) ; un
// SUPERADMIN la confirme, ce qui prolonge Organization.currentPeriodEnd.
// Montants entiers en FCFA (plus petite unité, pas de décimales).
model SubscriptionPayment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           String // "PREMIUM"
  amount         Int // FCFA — montant NET à payer (après réduction éventuelle)
  method         String // "CASH" | "MOBILE"
  months         Int          @default(1) // durée couverte par le paiement
  status         String       @default("PENDING") // PENDING | CONFIRMED | REJECTED
  discountCode   String? // code de réduction appliqué (null = aucun)
  baseAmount     Int? // prix avant réduction (renseigné si un code a été appliqué)
  periodStart    DateTime? // renseigné à la confirmation
  periodEnd      DateTime? // renseigné à la confirmation
  note           String?
  requestedById  String // user (patron) ayant émis la demande
  confirmedById  String? // admin ayant confirmé/refusé
  confirmedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
}

// Code de réduction sur l'abonnement (Phase 8). Créé par un SUPERADMIN dans le
// back-office, saisi par le patron avant d'émettre sa demande de paiement.
// `type` = PERCENT (value en %) ou AMOUNT (value en FCFA à retrancher).
// `maxUses` null = illimité ; `usedCount` incrémenté à chaque demande l'utilisant.
model DiscountCode {
  id          String    @id @default(cuid())
  code        String    @unique // normalisé en MAJUSCULES
  type        String // "PERCENT" | "AMOUNT"
  value       Int // pourcentage (1–100) ou montant FCFA
  maxUses     Int? // null = illimité
  usedCount   Int       @default(0)
  expiresAt   DateTime? // null = pas d'expiration
  active      Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active])
}

// Bannière d'information globale affichée en haut de l'app à TOUS les patrons /
// vendeurs (maintenance, nouveauté, promo…). Gérée par un SUPERADMIN. Un seul
// enregistrement en pratique : l'app lit la bannière active la plus récente.
model AppBanner {
  id        String   @id @default(cuid())
  message   String // texte affiché (court)
  level     String   @default("INFO") // "INFO" | "WARNING" | "SUCCESS"
  active    Boolean  @default(false) // false = masquée pour tout le monde
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

// Role precedence: OWNER > ADMIN > MEMBER. The owner is also a member row
// (created in the same tx as the org) so list-my-orgs queries can join
// uniformly via memberships.
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgMembership", fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

// Invitation d'un employé à rejoindre une boutique par email (lien + jeton).
// Colonnes simples (pas de FK) pour rester additif. Jeton à usage unique qui
// expire ; `acceptedAt` non-null une fois consommé. L'email est normalisé en
// minuscule. Émis depuis /api/org/invitations, consommé par /api/invitations/[token]/accept.
model Invitation {
  id              String    @id @default(cuid())
  token           String    @unique
  email           String
  organizationId  String
  role            String    @default("MEMBER") // MEMBER | ADMIN
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([organizationId])
  @@index([email])
}

// ───────────────────────────────────────────────────────────────────────
// OAuth identities — one User can have N linked providers (Google, GitHub, …).
// (provider, providerAccountId) is unique so the same Google account can't
// link twice. Email matching at sign-in is intentional: if a user signed up
// with email/password and later "Sign in with Google" using the same email,
// we link the Google account to the existing user instead of creating a
// duplicate (see backend/src/routes/oauth.ts).
// ───────────────────────────────────────────────────────────────────────
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "github" | …
  providerAccountId String // sub from the OIDC ID token
  // Optional refresh token (encrypted at rest if you store one) — Google
  // only returns it on first consent with `access_type=offline`. Most
  // boilerplate flows don't need it; we keep the column for future use.
  refreshToken      String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String // EMAIL_VERIFY | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([code, type])
}

// ───────────────────────────────────────────────────────────────────────
// File uploads — Cloudinary (column names kept from the R2 era; no migration needed)
// ───────────────────────────────────────────────────────────────────────
model FileUpload {
  id        String   @id @default(cuid())
  userId    String? // nullable — uploads can be anonymous if route allows
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  key       String   @unique // Cloudinary public_id (column name historical — was R2 object key)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — durable email queue rows
// ───────────────────────────────────────────────────────────────────────
model EmailJob {
  id          String    @id @default(cuid())
  to          String
  subject     String
  html        String
  text        String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — notifications (at-most-once via dedupeKey)
// ───────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreferences {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // JSON map of { eventType: { email: bool, inApp: bool } } — flexible without migrations.
  prefs     Json     @default("{}")
  updatedAt DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────────────────
// Outbox — durable side-effects (notifications, emails) emitted from
// inside transactions (e.g. webhook handlers, withdrawal flow). Side-effect
// rows are inserted in the same tx as the state change, then a worker
// drains them. Survives crashes the previous postCommit-callback pattern
// silently dropped.
//
// `kind` is a free-form string the dispatcher routes on
// (e.g. "notification.payment_received", "email.payment_confirmation").
// ───────────────────────────────────────────────────────────────────────
model OutboxEvent {
  id          String    @id @default(cuid())
  kind        String
  payload     Json
  status      String    @default("PENDING") // PENDING | SENT | FAILED | DEAD
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, scheduledAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 2 — webhook idempotency log
// ───────────────────────────────────────────────────────────────────────
model WebhookLog {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([externalId, eventType])
  @@index([provider, createdAt])
}

// ───────────────────────────────────────────────────────────────────────
// Phase 3 — payments (Order + Withdrawal)
//
// `amount` is stored in the smallest unit of `currency` (no decimals).
// For XOF (FCFA, Senegal) that's 1 = 1 FCFA. For USD adapt to cents
// at the call site — the schema is currency-agnostic.
// ───────────────────────────────────────────────────────────────────────
model Order {
  id              String    @id @default(cuid())
  userId          String? // nullable — guest checkout supported
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount          Int // gross amount, smallest unit
  currency        String    @default("XOF") // ISO 4217
  status          String    @default("PENDING") // PENDING | PAID | EXPIRED | FAILED | REFUNDED
  customerEmail   String?
  customerPhone   String?
  customerName    String?
  metadata        Json? // app-specific fields

  // Stripe-grade idempotency. Required header on POST /api/orders; replay
  // with same value returns the original Order row instead of double-charging.
  // Nullable so existing rows pre-migration don't break the @unique constraint.
  idempotencyKey  String?   @unique

  // Provider reference
  provider         String // e.g. "bictorys"
  providerChargeId String? @unique
  paymentUrl       String? // checkout/redirect URL returned by provider
  paymentMethod    String? // WAVE | ORANGE_MONEY | FREE_MONEY (set on PAID by webhook)

  // Optional commission (for marketplace-style apps)
  commissionAmount Int?
  netAmount        Int?

  // Lifecycle
  expiresAt DateTime // PENDING expiry; not cleared on PAID (history)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([provider, providerChargeId])
}

model Withdrawal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  amount      Int // requested amount, smallest unit
  currency    String   @default("XOF")
  status      String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  destination Json // { method: "WAVE" | "ORANGE_MONEY" | ..., phone: "+221...", accountName?: "..." }

  // Provider reference
  provider         String // e.g. "bictorys"
  providerPayoutId String? @unique
  failureReason    String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  completedAt DateTime?

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@index([provider, providerPayoutId])
}
